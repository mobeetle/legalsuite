{
  "title": "Control: an open reviewer note prints the multi-line block, not the collapsed line",
  "kind": "mechanical",
  "json": false,
  "run": [
    "display.py",
    "--emit",
    "reviewer_note",
    "--sources",
    "3 verified",
    "--before",
    "cap uncapped"
